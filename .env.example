# Copy this file to .env and fill in real values. Never commit .env.
FLASK_SECRET_KEY=generate-a-long-random-secret

MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=queue_free_print

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
EDIT_GEMINI_MODEL=gemini-2.5-flash-lite

GOOGLE_MAPS_API_KEY=your_restricted_google_maps_api_key

VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@queuefreeprint.local

# 0 for local HTTP testing, 1 for HTTPS production
COOKIE_SECURE=0
FLASK_DEBUG=0
